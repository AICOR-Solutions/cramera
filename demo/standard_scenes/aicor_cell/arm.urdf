<?xml version="1.0"?>
<!-- Stylised 6-axis arm from automationMockup/src/camera_sim/cell_scene.xml
     (MJCF). Capsule geoms are approximated as a cylinder with sphere caps.
     The MJCF body arm_hand carries two hinges (j4, j5); URDF allows one
     joint per link, so arm_hand_pitch is inserted as a zero-offset link. -->
<robot name="aicor_cell_arm">

  <material name="arm_orange"><color rgba="0.95 0.55 0.05 1"/></material>
  <material name="arm_grey"><color rgba="0.35 0.35 0.38 1"/></material>
  <material name="gripper_black"><color rgba="0.15 0.15 0.15 1"/></material>

  <link name="arm_root"/>

  <link name="arm_basis">
    <visual>
      <origin xyz="0 0 0.06"/>
      <geometry><cylinder radius="0.09" length="0.12"/></geometry>
      <material name="arm_grey"/>
    </visual>
  </link>
  <joint name="arm_basis_fix" type="fixed">
    <parent link="arm_root"/>
    <child link="arm_basis"/>
    <origin xyz="0 0 0.97"/>
  </joint>

  <link name="arm_karussell">
    <visual>
      <origin xyz="0 0 0.06"/>
      <geometry><cylinder radius="0.07" length="0.12"/></geometry>
      <material name="arm_orange"/>
    </visual>
    <visual>
      <geometry><sphere radius="0.07"/></geometry>
      <material name="arm_orange"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.12"/>
      <geometry><sphere radius="0.07"/></geometry>
      <material name="arm_orange"/>
    </visual>
  </link>
  <joint name="arm_j1" type="revolute">
    <parent link="arm_basis"/>
    <child link="arm_karussell"/>
    <origin xyz="0 0 0.12"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1" upper="3.1" effort="100" velocity="1"/>
  </joint>

  <link name="arm_oberarm">
    <visual>
      <origin xyz="0 0 0.275"/>
      <geometry><cylinder radius="0.055" length="0.55"/></geometry>
      <material name="arm_orange"/>
    </visual>
    <visual>
      <geometry><sphere radius="0.055"/></geometry>
      <material name="arm_orange"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.55"/>
      <geometry><sphere radius="0.055"/></geometry>
      <material name="arm_orange"/>
    </visual>
  </link>
  <joint name="arm_j2" type="revolute">
    <parent link="arm_karussell"/>
    <child link="arm_oberarm"/>
    <origin xyz="0 0 0.12"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="100" velocity="1"/>
  </joint>

  <link name="arm_unterarm">
    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry><cylinder radius="0.045" length="0.50"/></geometry>
      <material name="arm_orange"/>
    </visual>
    <visual>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="arm_orange"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.50"/>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="arm_orange"/>
    </visual>
  </link>
  <joint name="arm_j3" type="revolute">
    <parent link="arm_oberarm"/>
    <child link="arm_unterarm"/>
    <origin xyz="0 0 0.55"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="100" velocity="1"/>
  </joint>

  <link name="arm_hand_pitch"/>
  <joint name="arm_j4" type="revolute">
    <parent link="arm_unterarm"/>
    <child link="arm_hand_pitch"/>
    <origin xyz="0 0 0.50"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="100" velocity="1"/>
  </joint>

  <link name="arm_hand">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.035" length="0.10"/></geometry>
      <material name="arm_grey"/>
    </visual>
    <visual>
      <geometry><sphere radius="0.035"/></geometry>
      <material name="arm_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.10"/>
      <geometry><sphere radius="0.035"/></geometry>
      <material name="arm_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.13"/>
      <geometry><box size="0.09 0.03 0.06"/></geometry>
      <material name="gripper_black"/>
    </visual>
  </link>
  <joint name="arm_j5" type="revolute">
    <parent link="arm_hand_pitch"/>
    <child link="arm_hand"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1" upper="3.1" effort="100" velocity="1"/>
  </joint>

</robot>
