#usda 1.0
(
    doc = """The environment of the workshop twin: a floor and a bench, without any robot."""
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Cube "Floor"
    {
        double size = 1
        double3 xformOp:scale = (4, 4, 0.02)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }

    def Xform "Bench"
    {
        custom string sdt:class = "workbench"
        double3 xformOp:translate = (1, 0, 0.4)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Top"
        {
            double size = 0.8
        }
    }
}
