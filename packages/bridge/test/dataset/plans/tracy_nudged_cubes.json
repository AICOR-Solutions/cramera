{
  "formatVersion": "1.3",
  "name": "nudged_and_removed_cubes",
  "task": "Detect the red cube and put it into the centre zone, then put the blue cube into the right tray, each kept in view of Tracy's camera while it is picked up.",
  "robots": [
    {
      "id": "robot_1",
      "model": "tracy",
      "label": "Tracy",
      "pose": [0, 0, 0, 0, 0, 0, 1],
      "steps": [
        {"id": "step_1", "action": "park_arms", "values": {"arms": "both"}},
        {"id": "step_2", "action": "detect",
         "values": {"technique": "types", "object_sem_annotation": "block", "region": {"kind": "table"}, "color": "red"}},
        {"id": "step_3", "action": "pick_up", "values": {"grasp": "detected:step_2", "arm": "automatic"},
         "constraints": [
           {"text": "Look where it operates", "monitorType": "InFieldOfView",
            "monitor": {"type": "InFieldOfView", "params": {"target": "detected:step_2", "margin": 0.02}}}
         ]},
        {"id": "step_4", "action": "place",
         "values": {"object_designator": "detected:step_2", "target_location": {"placement": "zone", "zone": "center"}}},
        {"id": "step_5", "action": "pick_up", "values": {"grasp": "blue_cube", "arm": "automatic"},
         "constraints": [
           {"text": "Look where it operates", "monitorType": "InFieldOfView",
            "monitor": {"type": "InFieldOfView", "params": {"target": "blue_cube", "margin": 0.02}}}
         ]},
        {"id": "step_6", "action": "place",
         "values": {"object_designator": "blue_cube", "target_location": {"placement": "zone", "zone": "right_tray"}}}
      ]
    }
  ],
  "objects": [
    {"id": "red_cube", "model": "cube_library/objects/cubes/red_cube/model.urdf", "pose": [0.55, 0.10, 0.906, 0, 0, 0, 1]},
    {"id": "blue_cube", "model": "cube_library/objects/cubes/blue_cube/model.urdf", "pose": [0.55, 0.30, 0.906, 0, 0, 0, 1]}
  ],
  "selectedRobot": "robot_1"
}
