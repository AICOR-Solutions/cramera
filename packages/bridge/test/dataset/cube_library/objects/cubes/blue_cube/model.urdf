<?xml version="1.0"?>
<!-- A blue cube of 5 cm edge, 50 g. -->
<robot name="blue_cube">
  <material name="blue">
    <color rgba="0.10 0.25 0.80 1"/>
  </material>
  <link name="blue_cube">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="2.08e-5" iyy="2.08e-5" izz="2.08e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
    </collision>
  </link>
</robot>
