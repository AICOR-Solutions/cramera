<?xml version="1.0"?>
<robot name="cabinet">
  <link name="body">
    <visual><geometry><mesh filename="meshes/door.stl"/></geometry></visual>
  </link>
  <link name="drawer">
    <visual><geometry><mesh filename="package://kitchen/meshes/handle.obj"/></geometry></visual>
    <visual><geometry><box size="0.1 0.1 0.1"/></geometry></visual>
  </link>
  <joint name="slide" type="prismatic">
    <parent link="body"/>
    <child link="drawer"/>
    <limit lower="0" upper="0.4" effort="1" velocity="1"/>
  </joint>
</robot>
